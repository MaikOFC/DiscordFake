# Porta do servidor (Fastify + Socket.IO)
PORT=3001

# Endereços extras do cliente web liberados no CORS, separados por vírgula.
# O app de desktop e o Vite (porta 5173) em qualquer IP deste PC já são liberados.
CLIENT_ORIGIN=http://localhost:5173

# LiveKit em modo --dev (npm run livekit). O "npm run hospedar" usa chaves
# próprias, guardadas em .env.hospedagem, e não mexe nestas.
# Se o cliente entrar por outro endereço (o IP do Radmin, por exemplo), o
# servidor troca o "localhost" abaixo por esse endereço sozinho.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Opcional: em que endereço o servidor ouve (padrão 0.0.0.0, toda a rede).
# Atrás de um proxy como o Caddy, use 127.0.0.1 e diga em quem confiar para
# ler o IP real de cada pessoa (o scripts/servidor/instalar.sh já faz isso).
# HOST=127.0.0.1
# TRUST_PROXY=loopback

# Opcional: caminho completo do banco e dos arquivos enviados (padrão: apps/server/data)
# DB_PATH=D:/NexusVoice/dados/nexusvoice.db
# UPLOADS_DIR=D:/NexusVoice/dados/uploads
